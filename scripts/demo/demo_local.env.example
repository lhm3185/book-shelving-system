# PC 마다 다른 값. 이 파일을 demo_local.env 로 복사해서 쓴다 (git 에 안 올라간다).
#
#   cp scripts/demo/demo_local.env.example scripts/demo/demo_local.env

# Isaac 을 띄울 PC. GPU PC 에 직접 앉아서 돌리면 local
SIM_HOST=10.10.0.2
SIM_USER=rokey

# GPU PC 안의 경로
SIM_REPO=~/b1_arm
SIM_LEVEL_DIR=~/Desktop/Collected_ing_library_env_v5-firstFinal
SIM_BOOK_GLOB='~/book_dataset/usd_v2/book_encyclopedia_set_01_2k__book_encyclopedia_set_01_book0[1-6].usdc'

# 팀 공통 도메인. 작업 중 다른 값을 쓰더라도 **시연은 130**
ROS_DOMAIN_ID=130
