# **환경변수가 먼저다** — 전부 ${VAR:-기본값} 꼴로 둔다. 그냥 대입하면
# `GOAL_X=... ./pick.sh` 같은 문서화된 사용법이 조용히 무시된다 (2026-09-20 점검에서 발견).
# 프로파일: shelf — **실제 서가 앞 배치, 삽입까지 시도** (2026-09-20 기준 approach 미해결)
#
# 이 프로파일은 아직 통과하지 못했다. 서가 앞에서 approach 가 어깨 막힘으로 시간 초과한다.
# 원인 후보와 배제 목록: docs/doyoon-kim/web_claude/v20.md §5

SIM_LEVEL_NAME="${SIM_LEVEL_NAME:-level_shelf01.usd}"
SIM_SHELF_PRIM=/World/bookshelves/shelf_brown__book_shelf_01
SIM_SHELF_ROW_Z=1.042

# 팔 기준 꽂을 좌표. z = 선반판 1.042 + 책높이/2 0.1187 + 삽입여유 0.004 - 베이스 0.655
# **Franka 의 0.3399 를 쓰면 안 된다** — M0609 는 베이스가 37cm 높아 두 선반 단 사이 허공이다
GOAL_X="${GOAL_X:--0.3097}"
GOAL_Y="${GOAL_Y:-0.5495}"
GOAL_Z="${GOAL_Z:-0.5097}"

# 북엔드 x. **칸 좌표와 같아야 한다** — 다르면 북엔드가 만들어진 자리에 남고,
# 가장 바깥 칸에서는 북엔드가 책과 8mm 겹친다 (2026-09-21 점검에서 발견).
PLACE_DX="${PLACE_DX:--0.4697 -0.3897 -0.3097 -0.2297}"

PROFILE_NOTE="서가 삽입. 2026-09-20 기준 approach 미해결 — 시연 전 확인 필요"
