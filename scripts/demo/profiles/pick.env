# **환경변수가 먼저다** — 전부 ${VAR:-기본값} 꼴로 둔다. 그냥 대입하면
# `GOAL_X=... ./pick.sh` 같은 문서화된 사용법이 조용히 무시된다 (2026-09-20 점검에서 발견).
# 프로파일: pick — **트레이 책을 집어 드는 것까지** (2026-09-20 재현 확인)
#
# 서가에서 먼 배치다. 삽입은 하지 않는다 (서가 앞 배치는 approach 가 아직 막혀 있다 →
# docs/doyoon-kim/web_claude/v20.md §5). 1차 시연의 (나)안이 이것이다.

SIM_LEVEL_NAME="${SIM_LEVEL_NAME:-level_yaw0.usd}"
SIM_SHELF_PRIM=
SIM_SHELF_ROW_Z=

# 이 프로파일에서 쓰는 꽂을 좌표 (팔 기준, arm_base_link)
GOAL_X="${GOAL_X:--0.3497}"
GOAL_Y="${GOAL_Y:-0.5495}"
GOAL_Z="${GOAL_Z:-0.3399}"

# 파지 전용이라 북엔드는 쓰지 않지만, 기본값(Franka 대역)이 이 좌표와 맞아 그대로 둔다
PLACE_DX="${PLACE_DX:-}"

PROFILE_NOTE="트레이 책 파지까지. 운반 중 M406(손 안에서 미끄러짐)이 날 수 있다 — 기존 이슈"
