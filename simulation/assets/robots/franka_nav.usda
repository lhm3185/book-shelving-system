        def OmniGraphNode "ReadBaseWorldPose"
        {
            custom rel inputs:prim = </World/ridgeback_franka/base_link> (
                customData = {
                    dictionary omni = {
                        dictionary graph = {
                            string relType = "target"
                        }
                    }
                }
            )
            token node:type = "isaacsim.core.nodes.IsaacReadWorldPose"
            int node:typeVersion = 2
            custom quatd outputs:orientation
            custom vector3d outputs:scale
            custom vector3d outputs:translation
